# Copia este archivo como .env (en ventas-service/) y completa DB_PASSWORD.
# El .env NO se sube a GitHub; este .env.example sí.
#
# Para levantar SQL Server 2022 en Docker (usa tu propia contraseña: mayúsculas, minúsculas, números y símbolo):
#   docker run -d --name ferrestock-mssql --restart unless-stopped -e ACCEPT_EULA=Y -e MSSQL_SA_PASSWORD=<tu_password> -p 14333:1433 -v ferrestock-mssql-data:/var/opt/mssql mcr.microsoft.com/mssql/server:2022-latest
# Y crear la base (Hibernate crea las tablas, pero no la base):
#   docker exec ferrestock-mssql /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P <tu_password> -C -Q "CREATE DATABASE ferrestock_ventas"
DB_URL=jdbc:sqlserver://localhost:14333;databaseName=ferrestock_ventas;encrypt=true;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=
