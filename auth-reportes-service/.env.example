# Opcional: copiar como .env y ejecutar desde auth-reportes-service.
PORT=8081
# Sin perfil SQL no se crea datasource ni se consulta la base.
# Perfil explicito auth-db: completar externamente; nunca usar sa/migrator en runtime.
# AUTH_DB_URL=jdbc:sqlserver://127.0.0.1:14333;databaseName=ferrestock_auth_dev;encrypt=true;trustServerCertificate=false
# AUTH_DB_USER=ferrestock_auth_app
# AUTH_DB_PASSWORD=
# Perfil auth-integration: solo estas variables, nunca fallback a AUTH_DB_*.
# AUTH_TEST_DB_URL=jdbc:sqlserver://127.0.0.1:14333;databaseName=ferrestock_auth_test;encrypt=true;trustServerCertificate=false
# AUTH_TEST_DB_USER=ferrestock_auth_test_app
# AUTH_TEST_DB_PASSWORD=
